    {
      "parameters": {
        "jsCode": "const apiVerisi = $input.first().json;\n\n// API 1 TL karşılığını verdiği için 1'e bölerek gerçek Dolar/TL ve Euro/TL kurunu buluyoruz\nconst dolarTL = 1 / apiVerisi.rates.USD;\nconst euroTL = 1 / apiVerisi.rates.EUR;\n\n// Bugünün tarihini YYYY-AA-GG formatında alıyoruz\nconst bugun = new Date().toISOString().split('T')[0];\n\n// Ayrı Kritik Eşik Değerleri\nconst dolarKritikEsik = 50.00;\nconst euroKritikEsik = 55.00;\n\n// Dolar ve Euro için ayrı ayrı eşik kontrolü\nconst dolarDurum = dolarTL >= dolarKritikEsik ? 'KRİTİK SEVİYE' : 'NORMAL';\nconst euroDurum = euroTL >= euroKritikEsik ? 'KRİTİK SEVİYE' : 'NORMAL';\n\n// En az biri kritik eşiği aştıysa genel durum KRİTİK SEVİYE olur\nconst genelDurum = (dolarDurum === 'KRİTİK SEVİYE' || euroDurum === 'KRİTİK SEVİYE') \n  ? 'KRİTİK SEVİYE' \n  : 'NORMAL';\n\nreturn [\n  {\n    json: {\n      Tarih: bugun,\n      Dolar_TL: Number(dolarTL.toFixed(4)),\n      Euro_TL: Number(euroTL.toFixed(4)),\n      Dolar_Durum: dolarDurum,\n      Euro_Durum: euroDurum,\n      Genel_Durum: genelDurum\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -624,
